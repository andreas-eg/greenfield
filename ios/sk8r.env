# Beargarden sk8r's iPhone app: the lens's iOS shell (lens/ios/app.sh) with this realm and
# Beargarden's game modes. Paths are relative to this folder.
#   cd <lens>/ios && ./app.sh <beargarden>/ios/sk8r.env build <simulator id>
APP_NAME=Sk8r
APP_DISPLAY_NAME="Sk8r"
# com.eldergrounds.beargarden is the native app's (apple/project.yml).
APP_BUNDLE_ID=com.eldergrounds.beargarden.sk8r
APP_BUILD=1
APP_REALM=../world
APP_RUST_DIR=../app
APP_RUST_LIB=libbeargarden_app.a
APP_ENTRY=beargarden_main
# From the Firebase console once the app has one; not committed.
APP_FIREBASE_PLIST=GoogleService-Info.plist
APP_FIREBASE_PROJECT=soder-d9215
# TestFlight tags apart from Söder's testflight-N.
APP_TAG_PREFIX=sk8r-testflight-
